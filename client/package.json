    "@tanstack/react-virtual": "^3.14.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/bun": "^1.2.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
